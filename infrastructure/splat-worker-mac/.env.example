# Native macOS Brush splat worker — host-side config.
#
# The FigureCollector stack runs in Docker; this worker runs on the host (to
# reach the Metal GPU), so it talks to the stack through the PUBLISHED ports.
# Copy to .env and fill in the Garage credentials (the same S3_ACCESS_KEY /
# S3_SECRET_KEY the backend uses).

DATABASE_URL=postgres://figurecollector:figurecollector_dev@localhost:8432/figurecollector
S3_ENDPOINT=http://localhost:3902
S3_BUCKET=figurecollector
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=garage

POLL_INTERVAL=10
TRAINING_ITERATIONS=15000

# Defaults to ~/.cache/fc-brush/target/release/brush — set only if you built
# Brush elsewhere.
# BRUSH_BIN=/Users/you/.cache/fc-brush/target/release/brush
COLMAP_BIN=colmap

# Foreground masking — strongly recommended for turntable captures (the static
# background otherwise dominates SfM). Requires rembg (see requirements.txt).
ENABLE_MASKING=false
