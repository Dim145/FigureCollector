# ============================================================================
# FigureCollector server — environment variables
# Copy to .env (gitignored) and fill in.
# ============================================================================

# --- Core ---
FC_BIND_ADDR=0.0.0.0:3000
RUST_LOG=info,figurecollector_server=debug

# --- Frontend URL for CORS / OIDC redirects ---
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Phase 1+ (auth, sessions, persistence) — uncomment as features land.
# ============================================================================

# --- PostgreSQL ---
# DATABASE_URL=postgres://figurecollector:figurecollector_dev@postgres:5432/figurecollector

# --- Sessions (>=32 random bytes, base64) ---
# SESSION_SECRET=

# --- Auth ---
# ALLOW_LOCAL_SIGNUP=true                # set false to lock down registration

# OIDC providers — only enabled when the matching CLIENT_ID + CLIENT_SECRET are set.
# Callbacks land at <OIDC_REDIRECT_BASE>/api/auth/callback/<provider>
# OIDC_REDIRECT_BASE=http://localhost:5173   # defaults to FRONTEND_URL

# --- Google OIDC ---
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_DISPLAY_NAME=Google
# OIDC_GOOGLE_ISSUER_URL=https://accounts.google.com
# OIDC_GOOGLE_SCOPES=openid,email,profile

# --- Generic OIDC (Authelia, Authentik, Keycloak, …) ---
# OIDC_GENERIC_CLIENT_ID=
# OIDC_GENERIC_CLIENT_SECRET=
# OIDC_GENERIC_DISPLAY_NAME=Single sign-on
# OIDC_GENERIC_ISSUER_URL=https://sso.example.com
# OIDC_GENERIC_SCOPES=openid,email,profile

# --- Rate limiting ---
# RATE_LIMIT_PER_SECOND=10
# RATE_LIMIT_BURST=30

# -- MCP endpoint (/mcp) — agent access via per-user API keys ------------------
# On by default; an admin can close it instance-wide from Administration →
# Réglages. Users mint their own keys under Réglages → Accès API.
#
# The transport validates the Host header to block DNS rebinding and accepts
# loopback plus whatever FRONTEND_URL resolves to. Serving the app on a second
# hostname (an API domain, a tunnel) means listing it here, or requests arrive
# as "403 Forbidden: Host header is not allowed".
# MCP_ALLOWED_HOSTS=api.figures.example.com,figures.example.com
# Per-API-KEY (not per-IP) budget — several clients behind one NAT get their own.
# MCP_RATE_LIMIT_PER_SECOND=5
# MCP_RATE_LIMIT_BURST=20

# ============================================================================
# Phase 2+ (object storage, MFC scraping) — uncomment as features land.
# ============================================================================

# --- Object storage: Garage (Deuxfleurs) — S3-compatible ---
# Project: https://git.deuxfleurs.fr/Deuxfleurs/garage
# Credentials are minted by `garage key create` after the cluster is initialised.
# See README.md → "Garage one-time init" for the bootstrap commands.
# S3_ENDPOINT=http://garage:3902
# S3_BUCKET=figurecollector
# S3_REGION=garage              # must match the s3_region in infrastructure/garage/garage.toml
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true      # Garage requires path-style addressing

# --- MFC scraping ---
# MFC_USER_AGENT="FigureCollector/0.1 (+https://github.com/Dim145/FigureCollector)"
# MFC_CACHE_TTL_HOURS=24
# MFC_RATE_LIMIT_PER_SECOND=1

# --- AniList ---
# ANILIST_USER_AGENT="FigureCollector/0.1 (+https://github.com/Dim145/FigureCollector)"

# ============================================================================
# Optional services
# ============================================================================

# --- Redis cache (Phase 2+) ---
# REDIS_URL=redis://redis:6379

# --- Error tracking (Sentry-compatible) ---
# SENTRY_DSN=

# --- File upload limits ---
# MAX_UPLOAD_SIZE_MB=10
# MAX_PHOTOS_PER_ITEM=8
