# =============================================================================
# FigureCollector — environment template
#
# Copy to `.env` (gitignored) and edit. Compose reads `.env` automatically.
# All values are OPTIONAL for dev — the compose file ships working defaults.
# Required values are noted below; everything else is just for overrides.
# =============================================================================

# -- Postgres ----------------------------------------------------------------
# Dev defaults are hardcoded in docker-compose.yml; only override in prod.
# POSTGRES_DB=figurecollector
# POSTGRES_USER=figurecollector
# POSTGRES_PASSWORD=

# -- Backend -----------------------------------------------------------------
# FRONTEND_URL=http://localhost:5173
# OIDC_REDIRECT_BASE=                         # defaults to FRONTEND_URL
# ALLOW_LOCAL_SIGNUP=true                     # set false to disable signup
# AUTH_RATE_LIMIT_PER_SECOND=2
# AUTH_RATE_LIMIT_BURST=5
# RUST_LOG=info,figurecollector_server=debug

# -- MCP endpoint (/mcp) — agent access via per-user API keys ------------------
# On by default; an admin can close it instance-wide from Administration →
# Réglages. Users mint their own keys under Réglages → Accès API.
#
# The transport validates the Host header to block DNS rebinding and accepts
# loopback plus whatever FRONTEND_URL resolves to. Serving the app on a second
# hostname (an API domain, a tunnel) means listing it here, or requests arrive
# as "403 Forbidden: Host header is not allowed".
# MCP_ALLOWED_HOSTS=api.figures.example.com,figures.example.com
# Per-API-KEY (not per-IP) budget — several clients behind one NAT get their own.
# MCP_RATE_LIMIT_PER_SECOND=5
# MCP_RATE_LIMIT_BURST=20

# -- OIDC (optional; local username/password works without these) ------------
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_DISPLAY_NAME=Google
# OIDC_GOOGLE_ISSUER_URL=https://accounts.google.com
# OIDC_GENERIC_CLIENT_ID=
# OIDC_GENERIC_CLIENT_SECRET=
# OIDC_GENERIC_ISSUER_URL=
# OIDC_GENERIC_DISPLAY_NAME=SSO

# -- Worker internal token (owned-photo tagging) -----------------------------
# Shared bearer secret letting the embed/GPU worker fetch a user's PRIVATE
# owned-item photos to tag them (WD-Tagger). Set the SAME value here (server
# reads WORKER_INTERNAL_TOKEN) and on the worker (EMBED_WORKER_TOKEN). Unset =
# owned-photo tagging stays OFF (the /api/internal route 404s — fail-closed).
# Generate: openssl rand -hex 32
# WORKER_INTERNAL_TOKEN=

# -- Garage (S3-compatible object storage) -----------------------------------
# In dev the `garage-init` container imports these as deterministic dev
# credentials. Override only if you want different keys.
# GARAGE_RPC_SECRET=                # 32-byte hex; generate: openssl rand -hex 32
# GARAGE_ADMIN_TOKEN=                # used by garage-init's admin API calls
# S3_BUCKET=figurecollector
# S3_REGION=garage
# S3_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
# S3_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# S3_FORCE_PATH_STYLE=true
# S3_ENDPOINT=http://garage:3902    # internal; only set when pointing at remote Garage

# -- Production-only (docker-compose.prod.yml) -------------------------------
# TAG=latest
# WEB_DOMAIN=figures.example.com
# FRONTEND_URL=https://figures.example.com
