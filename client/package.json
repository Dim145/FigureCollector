{
  "name": "figurecollector-client",
  "version": "0.46.0",
  "private": true,
  "type": "module",
  "description": "FigureCollector — self-hosted PWA frontend for figurine collection tracking",
  "scripts": {
    "fetch-ml-assets": "node scripts/fetch-ml-assets.mjs",
    "predev": "node scripts/fetch-ml-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-ml-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@huggingface/transformers": "^4.2.0",
    "@imgly/background-removal": "^1.7.0",
    "@tanstack/react-query": "^5.100.0",
    "dexie": "^4.4.0",
    "dexie-react-hooks": "^1.1.7",
    "gsplat": "^1.2.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-filerobot-image-editor": "^4.9.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^14.0.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<4.2.0": ">=4.2.0",
      "protobufjs@<7.6.3": ">=7.6.3"
    }
  }
}
