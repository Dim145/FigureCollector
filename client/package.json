{
  "name": "figurecollector-client",
  "version": "0.48.7",
  "private": true,
  "type": "module",
  "description": "FigureCollector — self-hosted PWA frontend for figurine collection tracking",
  "scripts": {
    "fetch-ml-assets": "node scripts/fetch-ml-assets.mjs",
    "predev": "node scripts/fetch-ml-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-ml-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.11",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@huggingface/transformers": "^4.3.2",
    "@tanstack/react-query": "^5.107.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "gsplat": "^1.2.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-filerobot-image-editor": "^4.9.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
